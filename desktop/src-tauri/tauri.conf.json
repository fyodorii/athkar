{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Athkar",
  "mainBinaryName": "Athkar",
  "version": "14.0.0",
  "identifier": "uk.waliud.athkar",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "node ../scripts/desktop-dist.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "أذكار ومواقيت",
        "width": 460,
        "height": 880,
        "minWidth": 360,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "waliud.uk",
    "shortDescription": "أذكار ومواقيت",
    "longDescription": "الأذكار ومواقيت الصلاة والقبلة والسبحة وورد الحفظ والتقويم والمناسبات وصفحات مصحف المدينة، مع تنبيهات ويندوز",
    "copyright": "خط مصحف المدينة © مجمع الملك فهد لطباعة المصحف الشريف",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Arabic", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
