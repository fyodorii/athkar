{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mogait",
  "mainBinaryName": "Mogait",
  "version": "18.0.0",
  "identifier": "uk.waliud.athkar",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "node ../scripts/desktop-dist.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "مواقيت",
        "width": 1400,
        "height": 860,
        "minWidth": 380,
        "minHeight": 560,
        "center": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "waliud.uk",
    "shortDescription": "مواقيت",
    "longDescription": "الأذكار وأوقات الشروق والضحى والثلث الأخير وأوقات النهي والقبلة والسبحة والإذاعة والتقويم والمناسبات وصفحات مصحف المدينة، مع تنبيهات ويندوز",
    "copyright": "خط مصحف المدينة © مجمع الملك فهد لطباعة المصحف الشريف",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Arabic", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
